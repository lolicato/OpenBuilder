## Citation

If you use OpenMembraneBuilder in your research, please cite both OpenMembraneBuilder (when a formal publication becomes available) and the original COBY publication:


@software{OpenMembraneBuilder2026,
  author  = {Jonathan Thelen, Melanie Koenig, Fabio Lolicato},
  title   = {OpenMembraneBuilder: A Community-Driven Open-Source Builder for Membrane Simulations},
  year    = {2026},
  url     = {https://github.com/lolicato/OpenMembraneBuilder},
  note    = {GUI and CLI builder for Martini coarse-grained membrane systems}
}}


@article{Andreasen2025,
	author = {Andreasen, Mikkel D. and Souza, Paulo C. T. and Schiøtt, Birgit and Zuzic, Lorena},
	title = {Creating Coarse-Grained Systems with COBY: Toward Higher Accuracy of Complex Biological Systems},
	journal = {Journal of Chemical Information and Modeling},
	volume = {0},
	number = {0},
	pages = {null},
	year = {0},
	doi = {10.1021/acs.jcim.5c00069},
	URL = {https://doi.org/10.1021/acs.jcim.5c00069},
	eprint = {https://doi.org/10.1021/acs.jcim.5c00069}
}
